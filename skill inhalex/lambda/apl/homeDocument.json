{
  "type": "APL",
  "version": "2023.3",
  "theme": "light",
  "mainTemplate": {
    "parameters": [
      "homeData"
    ],
    "item": {
      "type": "Frame",
      "width": "100vw",
      "height": "100vh",
      "background": "#F6FAF7",
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "Text",
            "position": "absolute",
            "right": "24dp",
            "top": "12dp",
            "width": "180dp",
            "height": "24dp",
            "text": "${homeData.userBadgeText}",
            "fontSize": "12dp",
            "fontWeight": "700",
            "color": "#087A24",
            "textAlign": "right",
            "maxLines": 1
          },
          {
            "type": "Image",
            "position": "absolute",
            "left": "3.5vw",
            "top": "2vh",
            "width": "31vw",
            "height": "15vh",
            "source": "${homeData.logo ? homeData.logo : 'https://res.cloudinary.com/doetag8zp/image/upload/v1782984136/NuevoLogo_bjfy2e.png'}",
            "scale": "best-fit",
            "align": "left"
          },
          {
            "type": "Frame",
            "position": "absolute",
            "left": "4vw",
            "top": "16vh",
            "width": "27vw",
            "height": "5.5vh",
            "background": "#E5F3E8",
            "borderColor": "#CBE4D1",
            "borderWidth": "1dp",
            "borderRadius": "24dp",
            "item": {
              "type": "Text",
              "width": "100%",
              "height": "100%",
              "text": "●  ${homeData.badge ? homeData.badge : 'Productos 100% naturales'}",
              "fontSize": "15dp",
              "fontWeight": "700",
              "color": "#087A24",
              "textAlign": "center",
              "textAlignVertical": "center",
              "maxLines": 1
            }
          },
          {
            "type": "Text",
            "position": "absolute",
            "left": "4vw",
            "top": "24vh",
            "width": "42vw",
            "height": "10vh",
            "text": "${homeData.titleTop ? homeData.titleTop : 'El Respiro'}",
            "fontSize": "58dp",
            "fontWeight": "700",
            "color": "#101A12",
            "maxLines": 1
          },
          {
            "type": "Text",
            "position": "absolute",
            "left": "4vw",
            "top": "33vh",
            "width": "42vw",
            "height": "10vh",
            "text": "${homeData.titleMiddle ? homeData.titleMiddle : 'Que'}",
            "fontSize": "58dp",
            "fontWeight": "700",
            "color": "#101A12",
            "maxLines": 1
          },
          {
            "type": "Text",
            "position": "absolute",
            "left": "4vw",
            "top": "42vh",
            "width": "42vw",
            "height": "10vh",
            "text": "${homeData.titleBottom ? homeData.titleBottom : 'Alivia'}",
            "fontSize": "58dp",
            "fontWeight": "700",
            "color": "#087A24",
            "maxLines": 1
          },
          {
            "type": "Frame",
            "position": "absolute",
            "left": "4vw",
            "top": "51vh",
            "width": "15vw",
            "height": "0.6vh",
            "background": "#94C89F",
            "borderRadius": "4dp"
          },
          {
            "type": "Text",
            "position": "absolute",
            "left": "4vw",
            "top": "55vh",
            "width": "41vw",
            "height": "14vh",
            "text": "${homeData.description ? homeData.description : 'Descubre aromas naturales pensados para acompañar tu bienestar diario. Explora las líneas de INHALEX y encuentra el aroma ideal para tu momento.'}",
            "fontSize": "18dp",
            "color": "#5E6B61",
            "maxLines": 5
          },
          {
            "type": "TouchWrapper",
            "position": "absolute",
            "left": "4vw",
            "top": "72vh",
            "width": "13vw",
            "height": "7vh",
            "onPress": [
              {
                "type": "SendEvent",
                "arguments": [
                  "openLines"
                ]
              }
            ],
            "item": {
              "type": "Frame",
              "width": "100%",
              "height": "100%",
              "background": "#087A24",
              "borderRadius": "18dp",
              "item": {
                "type": "Text",
                "width": "100%",
                "height": "100%",
                "text": "${homeData.exploreButton ? homeData.exploreButton : 'Explorar líneas'}",
                "fontSize": "16dp",
                "fontWeight": "700",
                "color": "#FFFFFF",
                "textAlign": "center",
                "textAlignVertical": "center",
                "maxLines": 1
              }
            }
          },
          {
            "type": "TouchWrapper",
            "position": "absolute",
            "left": "18vw",
            "top": "72vh",
            "width": "12vw",
            "height": "7vh",
            "onPress": [
              {
                "type": "SendEvent",
                "arguments": [
                  "openCatalog"
                ]
              }
            ],
            "item": {
              "type": "Frame",
              "width": "100%",
              "height": "100%",
              "background": "#FFFFFF",
              "borderColor": "#D5E7D9",
              "borderWidth": "1dp",
              "borderRadius": "18dp",
              "item": {
                "type": "Text",
                "width": "100%",
                "height": "100%",
                "text": "${homeData.catalogButton ? homeData.catalogButton : 'Ver catálogo'}",
                "fontSize": "16dp",
                "fontWeight": "700",
                "color": "#263329",
                "textAlign": "center",
                "textAlignVertical": "center",
                "maxLines": 1
              }
            }
          },
          {
            "type": "TouchWrapper",
            "position": "absolute",
            "left": "31vw",
            "top": "72vh",
            "width": "9vw",
            "height": "7vh",
            "onPress": [
              {
                "type": "SendEvent",
                "arguments": [
                  "openAccount"
                ]
              }
            ],
            "item": {
              "type": "Frame",
              "width": "100%",
              "height": "100%",
              "background": "#E5F3E8",
              "borderColor": "#CBE4D1",
              "borderWidth": "1dp",
              "borderRadius": "18dp",
              "item": {
                "type": "Text",
                "width": "100%",
                "height": "100%",
                "text": "${homeData.accountButton ? homeData.accountButton : 'Cuenta'}",
                "fontSize": "16dp",
                "fontWeight": "700",
                "color": "#087A24",
                "textAlign": "center",
                "textAlignVertical": "center",
                "maxLines": 1
              }
            }
          },
          {
            "type": "TouchWrapper",
            "position": "absolute",
            "left": "41vw",
            "top": "72vh",
            "width": "8vw",
            "height": "7vh",
            "onPress": [
              {
                "type": "SendEvent",
                "arguments": [
                  "openHelp"
                ]
              }
            ],
            "item": {
              "type": "Frame",
              "width": "100%",
              "height": "100%",
              "background": "#FFFFFF",
              "borderColor": "#D5E7D9",
              "borderWidth": "1dp",
              "borderRadius": "18dp",
              "item": {
                "type": "Text",
                "width": "100%",
                "height": "100%",
                "text": "${homeData.helpButton ? homeData.helpButton : 'Ayuda'}",
                "fontSize": "14dp",
                "fontWeight": "700",
                "color": "#263329",
                "textAlign": "center",
                "textAlignVertical": "center",
                "maxLines": 1
              }
            }
          },
          {
            "type": "Text",
            "position": "absolute",
            "left": "4vw",
            "top": "82vh",
            "width": "45vw",
            "height": "5vh",
            "text": "${homeData.instruction ? homeData.instruction : 'Puedes decir: línea verde, ver catálogo, ofertas o ayuda.'}",
            "fontSize": "14dp",
            "color": "#6F7B72",
            "maxLines": 1
          },
          {
            "type": "Frame",
            "position": "absolute",
            "left": "51vw",
            "top": "20vh",
            "width": "45vw",
            "height": "58vh",
            "background": "#ECF7EF",
            "borderColor": "#CEE7D4",
            "borderWidth": "2dp",
            "borderRadius": "30dp",
            "padding": "16dp",
            "item": {
              "type": "Video",
              "id": "introVideo",
              "source": "${homeData.videoUrl ? homeData.videoUrl : 'https://res.cloudinary.com/doetag8zp/video/upload/v1783172828/Aplicar_rt8hw5.mp4'}",
              "width": "100%",
              "height": "100%",
              "scale": "best-fit",
              "autoplay": true,
              "muted": true,
              "audioTrack": "none"
            }
          }
        ]
      }
    }
  }
}
