{
  "type": "APL",
  "version": "2023.3",
  "theme": "light",
  "mainTemplate": {
    "parameters": [
      "accountData"
    ],
    "item": {
      "type": "Frame",
      "width": "100vw",
      "height": "100vh",
      "background": "#F6FAF7",
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "Text",
            "position": "absolute",
            "right": "28dp",
            "top": "18dp",
            "width": "180dp",
            "height": "26dp",
            "text": "${accountData.userBadgeText}",
            "fontSize": "12dp",
            "fontWeight": "700",
            "color": "#087A24",
            "textAlign": "right",
            "maxLines": 1
          },
          {
            "type": "Frame",
            "position": "absolute",
            "left": "18vw",
            "top": "56dp",
            "width": "64vw",
            "height": "444dp",
            "background": "#FFFFFF",
            "borderColor": "#CBE4D1",
            "borderWidth": "2dp",
            "borderRadius": "28dp",
            "item": {
              "type": "Container",
              "width": "100%",
              "height": "100%",
              "paddingLeft": "34dp",
              "paddingRight": "34dp",
              "paddingTop": "24dp",
              "paddingBottom": "18dp",
              "items": [
                {
                  "type": "Image",
                  "width": "230dp",
                  "height": "58dp",
                  "source": "${accountData.logo}",
                  "scale": "best-fit",
                  "align": "center"
                },
                {
                  "type": "Text",
                  "width": "100%",
                  "height": "40dp",
                  "spacing": "8dp",
                  "text": "${accountData.title}",
                  "fontSize": "31dp",
                  "lineHeight": "35dp",
                  "fontWeight": "700",
                  "color": "#087A24",
                  "textAlign": "center",
                  "maxLines": 1
                },
                {
                  "type": "Text",
                  "width": "100%",
                  "height": "44dp",
                  "text": "${accountData.subtitle}",
                  "fontSize": "15dp",
                  "lineHeight": "20dp",
                  "color": "#5E6B61",
                  "textAlign": "center",
                  "maxLines": 2
                },
                {
                  "type": "Frame",
                  "width": "100%",
                  "height": "104dp",
                  "spacing": "14dp",
                  "background": "#ECF7EF",
                  "borderColor": "#D4EAD9",
                  "borderWidth": "1dp",
                  "borderRadius": "22dp",
                  "item": {
                    "type": "Container",
                    "width": "100%",
                    "height": "100%",
                    "paddingLeft": "24dp",
                    "paddingRight": "24dp",
                    "paddingTop": "16dp",
                    "items": [
                      {
                        "type": "Text",
                        "width": "100%",
                        "height": "26dp",
                        "text": "CÓDIGO TEMPORAL",
                        "fontSize": "12dp",
                        "fontWeight": "700",
                        "letterSpacing": "2dp",
                        "color": "#6B776E",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "width": "100%",
                        "height": "34dp",
                        "text": "${accountData.codeHint}",
                        "fontSize": "22dp",
                        "fontWeight": "700",
                        "color": "#172018",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "width": "100%",
                        "height": "22dp",
                        "text": "${accountData.statusText}",
                        "fontSize": "12dp",
                        "color": "#5E6B61",
                        "maxLines": 1
                      }
                    ]
                  }
                },
                {
                  "type": "Text",
                  "width": "100%",
                  "height": "26dp",
                  "spacing": "8dp",
                  "text": "${accountData.errorText}",
                  "fontSize": "13dp",
                  "fontWeight": "700",
                  "color": "#9B4B4B",
                  "textAlign": "center",
                  "maxLines": 1
                },
                {
                  "type": "Container",
                  "width": "100%",
                  "height": "52dp",
                  "direction": "row",
                  "spacing": "14dp",
                  "justifyContent": "center",
                  "items": [
                    {
                      "type": "TouchWrapper",
                      "width": "190dp",
                      "height": "52dp",
                      "onPress": [
                        {
                          "type": "SendEvent",
                          "arguments": [
                            "${accountData.isLinked ? 'openFavorites' : 'promptLinkToken'}"
                          ]
                        }
                      ],
                      "item": {
                        "type": "Frame",
                        "width": "100%",
                        "height": "100%",
                        "background": "#087A24",
                        "borderRadius": "22dp",
                        "item": {
                          "type": "Text",
                          "width": "100%",
                          "height": "100%",
                          "text": "${accountData.primaryButton}",
                          "fontSize": "15dp",
                          "fontWeight": "700",
                          "color": "#FFFFFF",
                          "textAlign": "center",
                          "textAlignVertical": "center",
                          "maxLines": 1
                        }
                      }
                    },
                    {
                      "type": "TouchWrapper",
                      "width": "170dp",
                      "height": "52dp",
                      "onPress": [
                        {
                          "type": "SendEvent",
                          "arguments": [
                            "openCatalog"
                          ]
                        }
                      ],
                      "item": {
                        "type": "Frame",
                        "width": "100%",
                        "height": "100%",
                        "background": "#FFFFFF",
                        "borderColor": "#BFDCC6",
                        "borderWidth": "2dp",
                        "borderRadius": "22dp",
                        "item": {
                          "type": "Text",
                          "width": "100%",
                          "height": "100%",
                          "text": "${accountData.secondaryButton}",
                          "fontSize": "15dp",
                          "fontWeight": "700",
                          "color": "#087A24",
                          "textAlign": "center",
                          "textAlignVertical": "center",
                          "maxLines": 1
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "width": "100%",
                  "height": "28dp",
                  "spacing": "10dp",
                  "text": "${accountData.footerText}",
                  "fontSize": "10dp",
                  "color": "#6F7B72",
                  "textAlign": "center",
                  "maxLines": 2
                }
              ]
            }
          }
        ]
      }
    }
  }
}
