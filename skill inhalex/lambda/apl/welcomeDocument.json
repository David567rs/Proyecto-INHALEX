{
  "type": "APL",
  "version": "2023.3",
  "theme": "light",
  "mainTemplate": {
    "parameters": [
      "welcomeData"
    ],
    "item": {
      "type": "Frame",
      "width": "100vw",
      "height": "100vh",
      "background": "#F6FAF7",
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "paddingLeft": "24dp",
        "paddingRight": "24dp",
        "paddingTop": "14dp",
        "paddingBottom": "12dp",
        "items": [
          {
            "type": "Container",
            "width": "100%",
            "height": "62dp",
            "direction": "row",
            "alignItems": "center",
            "items": [
              {
                "type": "Image",
                "source": "${welcomeData.logo}",
                "width": "168dp",
                "height": "58dp",
                "scale": "best-fit",
                "align": "left"
              },
              {
                "type": "Container",
                "grow": 1,
                "paddingLeft": "18dp",
                "justifyContent": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${welcomeData.title}",
                    "fontSize": "28dp",
                    "fontWeight": "700",
                    "color": "#087A24",
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${welcomeData.subtitle}",
                    "fontSize": "16dp",
                    "fontWeight": "600",
                    "color": "#5E6B61",
                    "spacing": "1dp",
                    "maxLines": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "width": "100%",
            "height": "58dp",
            "justifyContent": "center",
            "items": [
              {
                "type": "Text",
                "text": "${welcomeData.headline}",
                "width": "100%",
                "textAlign": "center",
                "fontSize": "28dp",
                "fontWeight": "700",
                "color": "#17351F",
                "maxLines": 1
              },
              {
                "type": "Text",
                "text": "${welcomeData.description}",
                "width": "88%",
                "alignSelf": "center",
                "textAlign": "center",
                "fontSize": "14dp",
                "lineHeight": "18dp",
                "color": "#5E6B61",
                "spacing": "3dp",
                "maxLines": 1
              }
            ]
          },
          {
            "type": "Sequence",
            "width": "100%",
            "height": "318dp",
            "scrollDirection": "vertical",
            "spacing": "18dp",
            "paddingLeft": "14vw",
            "paddingRight": "14vw",
            "paddingTop": "8dp",
            "paddingBottom": "10dp",
            "data": "${welcomeData.lines}",
            "item": {
              "type": "TouchWrapper",
              "width": "560dp",
              "height": "300dp",
              "onPress": [
                {
                  "type": "SendEvent",
                  "arguments": [
                    "openLine",
                    "${data.id}"
                  ]
                }
              ],
              "item": {
                "type": "Frame",
                "width": "100%",
                "height": "100%",
                "background": "#ECF7EF",
                "borderColor": "#BFE0C8",
                "borderWidth": "2dp",
                "borderRadius": "26dp",
                "item": {
                  "type": "Container",
                  "width": "100%",
                  "height": "100%",
                  "paddingTop": "10dp",
                  "paddingBottom": "10dp",
                  "alignItems": "center",
                  "items": [
                    {
                      "type": "Frame",
                      "width": "242dp",
                      "height": "198dp",
                      "background": "#FFFFFF",
                      "borderColor": "#D4EAD9",
                      "borderWidth": "1dp",
                      "borderRadius": "18dp",
                      "padding": "8dp",
                      "item": {
                        "type": "Image",
                        "source": "${data.image}",
                        "width": "100%",
                        "height": "100%",
                        "scale": "best-fit",
                        "align": "center"
                      }
                    },
                    {
                      "type": "Frame",
                      "width": "350dp",
                      "height": "42dp",
                      "background": "#FFFFFF",
                      "borderColor": "#CBE4D1",
                      "borderWidth": "1dp",
                      "borderRadius": "21dp",
                      "spacing": "8dp",
                      "item": {
                        "type": "Container",
                        "width": "100%",
                        "height": "100%",
                        "justifyContent": "center",
                        "items": [
                          {
                            "type": "Text",
                            "when": "${data.id == 'linea-verde'}",
                            "width": "100%",
                            "text": "Línea Verde",
                            "fontSize": "24dp",
                            "lineHeight": "28dp",
                            "fontWeight": "700",
                            "color": "#087A24",
                            "textAlign": "center",
                            "maxLines": 1
                          },
                          {
                            "type": "Text",
                            "when": "${data.id == 'linea-resfriado'}",
                            "width": "100%",
                            "text": "Línea Resfriado",
                            "fontSize": "24dp",
                            "lineHeight": "28dp",
                            "fontWeight": "700",
                            "color": "#087A24",
                            "textAlign": "center",
                            "maxLines": 1
                          },
                          {
                            "type": "Text",
                            "when": "${data.id == 'linea-estimulante'}",
                            "width": "100%",
                            "text": "Línea Estimulante",
                            "fontSize": "24dp",
                            "lineHeight": "28dp",
                            "fontWeight": "700",
                            "color": "#087A24",
                            "textAlign": "center",
                            "maxLines": 1
                          },
                          {
                            "type": "Text",
                            "when": "${data.id == 'linea-insomnio'}",
                            "width": "100%",
                            "text": "Línea Insomnio",
                            "fontSize": "24dp",
                            "lineHeight": "28dp",
                            "fontWeight": "700",
                            "color": "#087A24",
                            "textAlign": "center",
                            "maxLines": 1
                          },
                          {
                            "type": "Text",
                            "when": "${data.id == 'linea-ansiedad-estres'}",
                            "width": "100%",
                            "text": "Línea Ansiedad y Estrés",
                            "fontSize": "22dp",
                            "lineHeight": "26dp",
                            "fontWeight": "700",
                            "color": "#087A24",
                            "textAlign": "center",
                            "maxLines": 1
                          }
                        ]
                      }
                    },
                    {
                      "type": "Text",
                      "width": "500dp",
                      "height": "24dp",
                      "text": "${data.description}",
                      "fontSize": "15dp",
                      "lineHeight": "19dp",
                      "color": "#4F6255",
                      "textAlign": "center",
                      "spacing": "6dp",
                      "maxLines": 1
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "Text",
            "text": "${welcomeData.instruction}",
            "width": "100%",
            "height": "24dp",
            "textAlign": "center",
            "fontSize": "14dp",
            "fontWeight": "600",
            "color": "#5E6B61",
            "maxLines": 1
          },
          {
            "type": "Container",
            "width": "100%",
            "height": "76dp",
            "direction": "row",
            "justifyContent": "center",
            "alignItems": "center",
            "spacing": "14dp",
            "items": [
              {
                "type": "TouchWrapper",
                "width": "178dp",
                "height": "54dp",
                "onPress": [
                  {
                    "type": "SendEvent",
                    "arguments": [
                      "openCatalog"
                    ]
                  }
                ],
                "item": {
                  "type": "Frame",
                  "width": "100%",
                  "height": "100%",
                  "background": "#087A24",
                  "borderRadius": "18dp",
                  "item": {
                    "type": "Text",
                    "width": "100%",
                    "height": "100%",
                    "text": "Ver catálogo",
                    "fontSize": "16dp",
                    "fontWeight": "700",
                    "color": "#FFFFFF",
                    "textAlign": "center",
                    "textAlignVertical": "center",
                    "maxLines": 1
                  }
                }
              },
              {
                "type": "TouchWrapper",
                "width": "132dp",
                "height": "54dp",
                "onPress": [
                  {
                    "type": "SendEvent",
                    "arguments": [
                      "openHelp"
                    ]
                  }
                ],
                "item": {
                  "type": "Frame",
                  "width": "100%",
                  "height": "100%",
                  "background": "#E5F3E8",
                  "borderColor": "#CBE4D1",
                  "borderWidth": "1dp",
                  "borderRadius": "18dp",
                  "item": {
                    "type": "Text",
                    "width": "100%",
                    "height": "100%",
                    "text": "Ayuda",
                    "fontSize": "16dp",
                    "fontWeight": "700",
                    "color": "#087A24",
                    "textAlign": "center",
                    "textAlignVertical": "center",
                    "maxLines": 1
                  }
                }
              },
              {
                "type": "TouchWrapper",
                "width": "132dp",
                "height": "54dp",
                "onPress": [
                  {
                    "type": "SendEvent",
                    "arguments": [
                      "openHome"
                    ]
                  }
                ],
                "item": {
                  "type": "Frame",
                  "width": "100%",
                  "height": "100%",
                  "background": "#FFFFFF",
                  "borderColor": "#CBE4D1",
                  "borderWidth": "1dp",
                  "borderRadius": "18dp",
                  "item": {
                    "type": "Text",
                    "width": "100%",
                    "height": "100%",
                    "text": "Inicio",
                    "fontSize": "16dp",
                    "fontWeight": "700",
                    "color": "#17351F",
                    "textAlign": "center",
                    "textAlignVertical": "center",
                    "maxLines": 1
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
