{
  "type": "APL",
  "version": "2023.3",
  "theme": "light",
  "mainTemplate": {
    "parameters": [
      "catalogData"
    ],
    "item": {
      "type": "Frame",
      "width": "100vw",
      "height": "100vh",
      "background": "#F6FAF7",
      "item": {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "Text",
            "position": "absolute",
            "right": "28dp",
            "top": "8dp",
            "width": "180dp",
            "height": "24dp",
            "text": "${catalogData.userBadgeText}",
            "fontSize": "12dp",
            "fontWeight": "700",
            "color": "#087A24",
            "textAlign": "right",
            "maxLines": 1
          },
          {
            "type": "Container",
            "position": "absolute",
            "left": "4vw",
            "top": "14dp",
            "width": "92vw",
            "height": "84dp",
            "direction": "row",
            "alignItems": "center",
            "items": [
              {
                "type": "Image",
                "source": "${catalogData.logo}",
                "width": "220dp",
                "height": "78dp",
                "scale": "best-fit",
                "align": "left"
              },
              {
                "type": "Container",
                "grow": 1,
                "paddingLeft": "18dp",
                "justifyContent": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "${catalogData.title}",
                    "fontSize": "31dp",
                    "fontWeight": "700",
                    "color": "#087A24",
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${catalogData.subtitle}",
                    "fontSize": "16dp",
                    "color": "#5E6B61",
                    "spacing": "2dp",
                    "maxLines": 1
                  },
                  {
                    "type": "Text",
                    "text": "${catalogData.instruction}",
                    "fontSize": "13dp",
                    "color": "#6F7B72",
                    "spacing": "2dp",
                    "maxLines": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "Sequence",
            "position": "absolute",
            "left": "4vw",
            "top": "104dp",
            "width": "92vw",
            "height": "392dp",
            "scrollDirection": "vertical",
            "spacing": "10dp",
            "paddingTop": "4dp",
            "paddingBottom": "8dp",
            "data": "${catalogData.products}",
            "item": {
              "type": "TouchWrapper",
              "width": "100%",
              "height": "154dp",
              "onPress": [
                {
                  "type": "SendEvent",
                  "arguments": [
                    "openDetail",
                    "${data.slug}"
                  ]
                }
              ],
              "item": {
                "type": "Frame",
                "width": "100%",
                "height": "100%",
                "background": "#FFFFFF",
                "borderColor": "#CBE4D1",
                "borderWidth": "2dp",
                "borderRadius": "22dp",
                "item": {
                  "type": "Container",
                  "width": "100%",
                  "height": "100%",
                  "items": [
                    {
                      "type": "Frame",
                      "position": "absolute",
                      "left": "12dp",
                      "top": "8dp",
                      "width": "138dp",
                      "height": "138dp",
                      "background": "#ECF7EF",
                      "borderColor": "#D4EAD9",
                      "borderWidth": "1dp",
                      "borderRadius": "20dp",
                      "padding": "5dp",
                      "item": {
                        "type": "Image",
                        "source": "${data.image}",
                        "width": "100%",
                        "height": "100%",
                        "scale": "best-fill",
                        "align": "center",
                        "borderRadius": "15dp"
                      }
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "left": "164dp",
                      "top": "16dp",
                      "width": "50%",
                      "height": "34dp",
                      "text": "${data.name}",
                      "fontSize": "24dp",
                      "fontWeight": "700",
                      "color": "#17351F",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "left": "164dp",
                      "top": "51dp",
                      "width": "50%",
                      "height": "24dp",
                      "text": "${data.category}",
                      "fontSize": "15dp",
                      "fontWeight": "700",
                      "color": "#087A24",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "left": "164dp",
                      "top": "80dp",
                      "width": "55%",
                      "height": "48dp",
                      "text": "${data.description}",
                      "fontSize": "15dp",
                      "lineHeight": "20dp",
                      "color": "#5E6B61",
                      "maxLines": 2
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "right": "70dp",
                      "top": "32dp",
                      "width": "21%",
                      "height": "32dp",
                      "text": "$${data.price} ${data.currency}",
                      "fontSize": "20dp",
                      "fontWeight": "700",
                      "color": "#087A24",
                      "textAlign": "right",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "right": "70dp",
                      "top": "72dp",
                      "width": "21%",
                      "height": "28dp",
                      "text": "${data.stockAvailable > 0 ? 'Disponible' : 'Agotado'}",
                      "fontSize": "15dp",
                      "fontWeight": "700",
                      "color": "${data.stockAvailable > 0 ? '#087A24' : '#9B4B4B'}",
                      "textAlign": "right",
                      "maxLines": 1
                    },
                    {
                      "type": "Text",
                      "position": "absolute",
                      "right": "24dp",
                      "top": "48dp",
                      "width": "34dp",
                      "height": "52dp",
                      "text": ">",
                      "fontSize": "36dp",
                      "fontWeight": "700",
                      "color": "#94C89F",
                      "textAlign": "center",
                      "textAlignVertical": "center",
                      "maxLines": 1
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "Frame",
            "when": "${catalogData.products.length == 0}",
            "position": "absolute",
            "left": "18vw",
            "top": "220dp",
            "width": "64vw",
            "height": "116dp",
            "background": "#FFFFFF",
            "borderColor": "#CBE4D1",
            "borderWidth": "2dp",
            "borderRadius": "24dp",
            "item": {
              "type": "Text",
              "width": "100%",
              "height": "100%",
              "text": "${catalogData.subtitle}",
              "fontSize": "20dp",
              "lineHeight": "26dp",
              "fontWeight": "700",
              "color": "#5E6B61",
              "textAlign": "center",
              "textAlignVertical": "center",
              "maxLines": 3
            }
          },
          {
            "type": "Frame",
            "position": "absolute",
            "left": "4vw",
            "bottom": "12dp",
            "width": "92vw",
            "height": "74dp",
            "background": "#F6FAF7",
            "item": {
              "type": "Container",
              "width": "100%",
              "height": "100%",
              "direction": "row",
              "justifyContent": "center",
              "alignItems": "center",
              "spacing": "14dp",
              "items": [
                {
                  "type": "TouchWrapper",
                  "width": "156dp",
                  "height": "54dp",
                  "onPress": [
                    {
                      "type": "SendEvent",
                      "arguments": [
                        "openHome"
                      ]
                    }
                  ],
                  "item": {
                    "type": "Frame",
                    "width": "100%",
                    "height": "100%",
                    "background": "#E5F3E8",
                    "borderColor": "#CBE4D1",
                    "borderWidth": "1dp",
                    "borderRadius": "18dp",
                    "item": {
                      "type": "Text",
                      "width": "100%",
                      "height": "100%",
                      "text": "Inicio",
                      "fontSize": "17dp",
                      "fontWeight": "700",
                      "color": "#087A24",
                      "textAlign": "center",
                      "textAlignVertical": "center",
                      "maxLines": 1
                    }
                  }
                },
                {
                  "type": "TouchWrapper",
                  "width": "188dp",
                  "height": "54dp",
                  "onPress": [
                    {
                      "type": "SendEvent",
                      "arguments": [
                        "openLines"
                      ]
                    }
                  ],
                  "item": {
                    "type": "Frame",
                    "width": "100%",
                    "height": "100%",
                    "background": "#FFFFFF",
                    "borderColor": "#CBE4D1",
                    "borderWidth": "1dp",
                    "borderRadius": "18dp",
                    "item": {
                      "type": "Text",
                      "width": "100%",
                      "height": "100%",
                      "text": "Explorar líneas",
                      "fontSize": "17dp",
                      "fontWeight": "700",
                      "color": "#17351F",
                      "textAlign": "center",
                      "textAlignVertical": "center",
                      "maxLines": 1
                    }
                  }
                },
                {
                  "type": "TouchWrapper",
                  "width": "148dp",
                  "height": "54dp",
                  "onPress": [
                    {
                      "type": "SendEvent",
                      "arguments": [
                        "openHelp"
                      ]
                    }
                  ],
                  "item": {
                    "type": "Frame",
                    "width": "100%",
                    "height": "100%",
                    "background": "#087A24",
                    "borderRadius": "18dp",
                    "item": {
                      "type": "Text",
                      "width": "100%",
                      "height": "100%",
                      "text": "Ayuda",
                      "fontSize": "17dp",
                      "fontWeight": "700",
                      "color": "#FFFFFF",
                      "textAlign": "center",
                      "textAlignVertical": "center",
                      "maxLines": 1
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
