# Configuracion publica. No colocar secretos en variables EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=https://inhalex-backend.onrender.com/api
# Desarrollo local: en Expo Go Android, localhost se sustituye por la IP privada de Expo en modo LAN.
# En web se conserva localhost. Reinicia Expo despues de cambiar esta variable.
# EXPO_PUBLIC_API_URL=http://localhost:3200/api
# Opcional: origen HTTPS para futuras imagenes externas. Las actuales se incluyen en assets/products.
# EXPO_PUBLIC_ASSET_URL=https://tu-dominio-de-imagenes.example
