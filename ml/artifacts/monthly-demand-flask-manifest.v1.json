    ],
    "encodedColumns": [
      "demanda_lag_1m",
      "demanda_lag_2m",
      "demanda_lag_3m",
      "promedio_demanda_3m",
      "pedidos_lag_1m",
      "precio_promedio_lag_1m",
      "rating_promedio_al_corte",
      "cantidad_resenas_al_corte",
      "numero_mes",
      "tendencia_calendario_meses",
      "product_id_SYN-PROD-001",
      "product_id_SYN-PROD-002",
      "product_id_SYN-PROD-003",
      "product_id_SYN-PROD-004",
      "product_id_SYN-PROD-005",
      "product_id_SYN-PROD-006",
      "product_id_SYN-PROD-007",
      "product_id_SYN-PROD-008",
      "product_id_SYN-PROD-009",
      "product_id_SYN-PROD-010",
